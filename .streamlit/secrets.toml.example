# Copy this file to `.streamlit/secrets.toml` and set a real password for local
# development. The real secrets.toml is gitignored and must NEVER be committed.
#
# On Streamlit Community Cloud, do NOT upload this file — instead paste these
# keys into the app's Settings → Secrets manager.

app_password = "change-me"

# Send Payslips tool — Gmail account that sends the payslips, plus a Gmail
# "App Password" (16 chars, generated at https://myaccount.google.com/apppasswords
# with 2-Step Verification on). Leave unset if you don't use that tool.
payslip_sender_email = "you@gmail.com"
payslip_app_password = "xxxx xxxx xxxx xxxx"
